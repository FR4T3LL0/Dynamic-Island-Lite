{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DynamicIslandLite",
  "version": "1.0.0-alpha.4",
  "identifier": "app.dynamicisland.lite",
  "build": {
    "windows": {
      "staticVCRuntime": true
    },
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Dynamic Island Lite",
        "width": 180,
        "height": 36,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "backgroundColor": "#00000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost island-image: http://island-image.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost island-image: http://island-image.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1421 ws://127.0.0.1:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/DynamicIslandLite-MIT.txt",
      "windows/LICENSE-MIT-TAURI.txt": "licenses/TAURI-NSIS-MIT.txt",
      "windows/third-party/": "licenses/third-party/"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi"
      }
    }
  }
}
